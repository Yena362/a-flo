rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 본인만 자기 문서(users/내uid)를 읽고 쓸 수 있어요
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 그 밖의 모든 곳은 막아요
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
